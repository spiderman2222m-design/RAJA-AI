rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isBootstrappedOwner() {
      return isVerified() && request.auth.token.email == 'spiderman2222m@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedOwner() ||
        (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUsageMap(u) {
      return u is map &&
        u.keys().hasAll([
          'chatCount',
          'voiceCount',
          'imageCount',
          'videoCount',
          'writerCount',
          'codeCount',
          'translateCount'
        ]) &&
        u.keys().hasOnly([
          'chatCount',
          'voiceCount',
          'imageCount',
          'videoCount',
          'writerCount',
          'codeCount',
          'translateCount'
        ]) &&
        u.chatCount is int && u.chatCount >= 0 && u.chatCount <= 1000000 &&
        u.voiceCount is int && u.voiceCount >= 0 && u.voiceCount <= 1000000 &&
        u.imageCount is int && u.imageCount >= 0 && u.imageCount <= 1000000 &&
        u.videoCount is int && u.videoCount >= 0 && u.videoCount <= 1000000 &&
        u.writerCount is int && u.writerCount >= 0 && u.writerCount <= 1000000 &&
        u.codeCount is int && u.codeCount >= 0 && u.codeCount <= 1000000 &&
        u.translateCount is int && u.translateCount >= 0 && u.translateCount <= 1000000;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        isValidId(data.grantedBy) &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'plan',
        'subscriptionStatus',
        'subscriptionBillingCycle',
        'subscriptionExpiresAt',
        'lastPaymentId',
        'preferredLanguage',
        'usage',
        'isBlocked',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'plan',
        'subscriptionStatus',
        'subscriptionBillingCycle',
        'subscriptionExpiresAt',
        'lastPaymentId',
        'preferredLanguage',
        'usage',
        'isBlocked',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.photoURL is string && data.photoURL.size() <= 500 &&
      data.role in ['user', 'admin'] &&
      data.plan in ['free', 'premium_monthly', 'premium_yearly'] &&
      data.subscriptionStatus in ['active', 'cancelled', 'expired'] &&
      data.subscriptionBillingCycle in ['none', 'monthly', 'yearly'] &&
      data.subscriptionExpiresAt is string && data.subscriptionExpiresAt.size() <= 64 &&
      data.lastPaymentId is string && data.lastPaymentId.size() <= 128 &&
      data.preferredLanguage in ['en', 'hi', 'gu'] &&
      isValidUsageMap(data.usage) &&
      data.isBlocked is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'title',
        'mode',
        'language',
        'messageCount',
        'lastMessagePreview',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'title',
        'mode',
        'language',
        'messageCount',
        'lastMessagePreview',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.mode in ['chat', 'voice', 'writer', 'code', 'translate'] &&
      data.language in ['en', 'hi', 'gu'] &&
      data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 100000 &&
      data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
        'id',
        'conversationId',
        'userId',
        'role',
        'content',
        'mode',
        'language',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'conversationId',
        'userId',
        'role',
        'content',
        'mode',
        'language',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.conversationId) &&
      isValidId(data.userId) &&
      data.role in ['user', 'assistant'] &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 50000 &&
      data.mode in ['chat', 'voice', 'writer', 'code', 'translate'] &&
      data.language in ['en', 'hi', 'gu'] &&
      data.createdAt is timestamp;
    }

    function isValidCreation(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'type',
        'prompt',
        'mediaUrl',
        'aspectRatio',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'type',
        'prompt',
        'mediaUrl',
        'aspectRatio',
        'status',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.type in ['image', 'video'] &&
      data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
      data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 500 &&
      data.aspectRatio is string && data.aspectRatio.size() >= 1 && data.aspectRatio.size() <= 16 &&
      data.status in ['completed', 'failed'] &&
      data.createdAt is timestamp;
    }

    function isValidPaymentRecord(data) {
      return data.keys().hasAll([
        'id',
        'userId',
        'plan',
        'amount',
        'currency',
        'provider',
        'transactionRef',
        'signature',
        'status',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'plan',
        'amount',
        'currency',
        'provider',
        'transactionRef',
        'signature',
        'status',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.plan in ['premium_monthly', 'premium_yearly'] &&
      (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 1000000 &&
      data.currency in ['INR', 'USD'] &&
      data.provider in ['razorpay_verified', 'stripe_verified', 'upi_verified'] &&
      data.transactionRef is string && data.transactionRef.size() >= 4 && data.transactionRef.size() <= 128 &&
      data.signature is string && data.signature.size() >= 16 && data.signature.size() <= 256 &&
      data.status == 'verified' &&
      data.createdAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll([
        'id',
        'freeLimits',
        'monthlyPriceInr',
        'yearlyPriceInr',
        'merchantUpiId',
        'updatedBy',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'freeLimits',
        'monthlyPriceInr',
        'yearlyPriceInr',
        'merchantUpiId',
        'updatedBy',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidUsageMap(data.freeLimits) &&
      (data.monthlyPriceInr is int || data.monthlyPriceInr is float) && data.monthlyPriceInr > 0 &&
      (data.yearlyPriceInr is int || data.yearlyPriceInr is float) && data.yearlyPriceInr > 0 &&
      data.merchantUpiId is string && data.merchantUpiId.size() >= 5 && data.merchantUpiId.size() <= 120 &&
      isValidId(data.updatedBy) &&
      data.updatedAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isBootstrappedOwner();
      allow create: if isValidId(adminUid) && isAdmin() && isValidAdminRecord(incoming()) &&
        incoming().uid == adminUid && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isBootstrappedOwner();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedOwner() || (isVerified() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().isBlocked == false &&
        incoming().plan == 'free' &&
        incoming().subscriptionStatus == 'active' &&
        incoming().subscriptionBillingCycle == 'none' &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isBootstrappedOwner()));

      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            existing().isBlocked == false &&
            incoming().role == existing().role &&
            incoming().isBlocked == existing().isBlocked && (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLanguage', 'usage', 'updatedAt'])
              ) ||
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'plan',
                  'subscriptionStatus',
                  'subscriptionBillingCycle',
                  'subscriptionExpiresAt',
                  'lastPaymentId',
                  'updatedAt'
                ]) &&
                incoming().lastPaymentId != existing().lastPaymentId &&
                isValidId(incoming().lastPaymentId) &&
                existsAfter(/databases/$(database)/documents/payments/$(incoming().lastPaymentId))
              )
            )
          )
        );

      allow delete: if isValidId(userId) && isBootstrappedOwner();
    }

    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) &&
        (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isBootstrappedOwner() ||
        (isVerified() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(conversationId) &&
        isVerified() &&
        isValidConversation(incoming()) &&
        incoming().id == conversationId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(conversationId) &&
        isVerified() &&
        isValidConversation(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'messageCount',
              'lastMessagePreview',
              'language',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(conversationId) &&
        (isAdmin() || (isVerified() && existing().userId == request.auth.uid));

      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && (
          isAdmin() ||
          (
            isVerified() &&
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          )
        );
        allow list: if isBootstrappedOwner() ||
          (isVerified() && resource.data.userId == request.auth.uid);

        allow create: if isValidId(conversationId) && isValidId(messageId) &&
          isVerified() &&
          isValidMessage(incoming()) &&
          incoming().id == messageId &&
          incoming().conversationId == conversationId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;

        allow update: if false;
        allow delete: if isValidId(conversationId) && isValidId(messageId) && (
          isAdmin() ||
          (
            isVerified() &&
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
          )
        );
      }
    }

    match /creations/{creationId} {
      allow get: if isValidId(creationId) &&
        (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isBootstrappedOwner() ||
        (isVerified() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(creationId) &&
        isVerified() &&
        isValidCreation(incoming()) &&
        incoming().id == creationId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(creationId) &&
        (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
    }

    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) &&
        (isAdmin() || (isVerified() && existing().userId == request.auth.uid));
      allow list: if isBootstrappedOwner() ||
        (isVerified() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(paymentId) &&
        isVerified() &&
        isValidPaymentRecord(incoming()) &&
        incoming().id == paymentId &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isBootstrappedOwner();
    }

    match /app_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(settingId) &&
        isAdmin() &&
        isValidAppSettings(incoming()) &&
        incoming().id == settingId &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
